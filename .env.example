# ============================================================
# TRACE-X Configuration Environment Variables
# ============================================================

# General App Settings
ENVIRONMENT=development
PROJECT_NAME="TRACE-X"
API_V1_STR="/api/v1"
SECRET_KEY="tracex-insecure-dev-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tracex_user
POSTGRES_PASSWORD=tracex_password
POSTGRES_DB=tracex_db
DATABASE_URL=postgresql+asyncpg://tracex_user:tracex_password@localhost:5432/tracex_db

# Threat Intelligence APIs (Optional in Demo Mode)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
PHISHTANK_API_KEY=
URLHAUS_API_KEY=

# AI / LLM Integration (Optional fallback to local/deterministic)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# GeoIP Location Database Path
GEOIP_CITY_DB_PATH=data/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=data/GeoLite2-ASN.mmdb

# Demo Mode Toggle
DEMO_MODE=true
